    android:viewportHeight="108">
    <path android:pathData="M54,54m-35,0a35,35 0,1 1,70 0a35,35 0,1 1,-70 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="35">
                <item android:offset="0.35" android:color="#8C0FB912" />
                <item android:offset="1" android:color="#000FB912" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="34"
                android:endX="74"
                android:endY="74">
                <item android:offset="0" android:color="#FF10820C" />
                <item android:offset="1" android:color="#FF0FB912" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
