# Secrets: each machine has its own .env with only what it needs.
.env
google-key.json
google-oauth-client.json
*-key.json
tokens/

.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Personal data: memory, notes, logs, voice recordings and results never go into git.
memory/
notes/
logs/
# Files on their way between devices (agent/natro_agent/files.py).
transfers/
testset/
results/

# Downloaded models (see pc/natro_pc/wakeword.py for the source).
models/
# Requests kept for a device that is offline (agent/natro_agent/pending.py).
pending.json
# The PC app's switches (desktop/src-tauri/src/settings.rs).
/settings.json
# The old .env after a change from the Settings window (keys.py, keys.rs).
.env.bak
.env.new
# His reminders (agent/natro_agent/reminders.py), when his last briefing was (briefing.py), and his routines
# (routines.py).
reminders.json
briefing.json
routines.json
# What he asked Natro to watch for, and what she told him (watchers.py).
watchers.json
# The tools his devices offered when last connected (agent/natro_agent/tools.py, KnownTools).
devices.json
